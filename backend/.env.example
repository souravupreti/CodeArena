# CodeArena Backend Environment Configuration

# Server Port
PORT=3000

# MongoDB Connection String (Mongoose Atlas Connection Format)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/<database>?retryWrites=true&w=majority
DB_CONNECT_STRING=mongodb+srv://your-atlas-username:your-atlas-password@cluster.mongodb.net/codearena?retryWrites=true&w=majority

# JWT Token Cryptographic Key
JWT_KEY=your-jwt-secure-random-bytes

# Redis Configuration (Upstash Connection Format)
# Hostname options (Choose ONE of the following):
# Option A: Connect using a unified connection string (Ideal for Upstash: rediss://default:password@endpoint:port)
REDIS_URL=rediss://default:your-upstash-redis-password@your-upstash-endpoint.upstash.io:30779

# Option B: Connect using individual parameters
REDIS_PASS=your-upstash-redis-password
REDIS_HOST=
REDIS_PORT=17490

# Third-Party API Keys
# Judge0 Execution Batch API Key (via RapidAPI or Self-hosted)
JUDGE0_KEY=your-rapidapi-judge0-key

# Google Generative AI (Gemini) API Key
GEMINI_KEY=your-google-gemini-api-key

# Cloudinary Configs for Editorial Videos
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
